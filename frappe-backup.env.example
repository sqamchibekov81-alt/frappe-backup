# Serverda: cp frappe-backup.env.example /etc/frappe-backup.env && chmod 600 /etc/frappe-backup.env
# Har server uchun SERVER_NAME, SB_USER, SB_HOST o'ziniki bo'ladi. TG_* hamma serverda bir xil.

# Telegram xabarida va restic snapshot'larida ko'rinadigan nom (har serverda boshqacha)
SERVER_NAME=server-01

# Bench joylashuvi va egasi
BENCH_DIR=/home/frappe/frappe-bench
BENCH_USER=frappe

# Hetzner Storage Box sub-account (Hetzner Console'da ko'rsatilgan login va host)
SB_USER=uXXXXX-sub1
SB_HOST=uXXXXX-sub1.your-storagebox.de

# restic: "storagebox" — install.sh yozadigan /root/.ssh/config dagi Host nomi.
# Yo'l nisbiy (sub-account papkasi ichida "restic" papka) — Hetzner shuni tavsiya qiladi.
RESTIC_REPOSITORY=sftp:storagebox:restic
RESTIC_PASSWORD_FILE=/root/.restic-password

# bench backup fayllari vaqtincha shu yerga yoziladi, yuborilgach o'chiriladi
STAGING_DIR=/home/frappe/backup-staging

# Saqlash muddati: oxirgi N kunlik, N haftalik, N oylik snapshot
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Telegram: xato bo'lganda xabar oladiganlar. Har biri avval botga /start yozgan bo'lishi kerak.
TG_BOT_TOKEN=
TG_CHAT_IDS="111111111 222222222"
